# ── Base de datos ─────────────────────────────────────────────────────────────
# En Railway esto se setea automáticamente al agregar el plugin PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_db

# ── Sesiones ───────────────────────────────────────────────────────────────────
# Cambiá esto por una cadena larga y aleatoria en producción
# Podés generar una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-esto-por-algo-aleatorio-largo

# ── Usuario admin inicial ──────────────────────────────────────────────────────
# Se crea automáticamente en el primer arranque si no hay usuarios
ADMIN_EMAIL=admin@SMsoluciones.com
ADMIN_PASSWORD=cambia-esta-contraseña

# ── Entorno ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000


# ── Zoom Giuliano (OAuth user-managed independiente) ──────────────────────────
# Usar las credenciales DEVELOPMENT de la General App mientras se prueba con Local Test.
ZOOM_GIULIANO_CLIENT_ID=
ZOOM_GIULIANO_CLIENT_SECRET=
ZOOM_GIULIANO_REDIRECT_URI=https://prospectos-sm-production.up.railway.app/zoom/oauth/callback

# ── Avisos privados de Ventas (sin grupo) ────────────────────────────────────
# Enviar al inbox privado de WhatsApp ya usado por los recordatorios del CRM.
# Mantener CHATWOOT_URL, CHATWOOT_ACCOUNT_ID, CHATWOOT_API_TOKEN, BOT_INBOX_ID
# y AUTOMATION_API_KEY configurados en Railway.
VENTAS_TELEFONO_RAFAEL=
VENTAS_TELEFONO_GIULIANO=
VENTAS_TELEFONO_SANTIAGO=
# No usar CONVERSACION_AVISOS_ID para Ventas: ya no se utiliza.

# Google Meet | demostraciones grupales AM 10:30, PM 15:30 (hora Buenos Aires)
# Links de Meet configurados en src/meet/calendar.js.
PUBLIC_BASE_URL=https://prospectos-sm-production.up.railway.app
# Clave aleatoria de 32+ caracteres. No compartir en mensajes ni URLs.
DEMO_BOOKING_SECRET=
# Opcional: cuentas para avisos de las demostraciones, vía WhatsApp individual.
DEMO_TELEFONO_MARISOL=
DEMO_TELEFONO_ROMAN=
# Obligatorio para generar reuniones PERSONALIZADAS desde el CRM.
# Autorizar ambos scopes: calendar.events y meetings.space.settings.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
