# ── Base de datos ─────────────────────────────────────────────────────────────
# En Railway esto se setea automáticamente al agregar el plugin PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_db

# ── Sesiones ───────────────────────────────────────────────────────────────────
# Cambiá esto por una cadena larga y aleatoria en producción
# Podés generar una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-esto-por-algo-aleatorio-largo

# ── Usuario admin inicial ──────────────────────────────────────────────────────
# Se crea automáticamente en el primer arranque si no hay usuarios
ADMIN_EMAIL=admin@SMsoluciones.com
ADMIN_PASSWORD=cambia-esta-contraseña

# ── Entorno ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000


# ── Zoom Giuliano (OAuth user-managed independiente) ──────────────────────────
# Usar las credenciales DEVELOPMENT de la General App mientras se prueba con Local Test.
ZOOM_GIULIANO_CLIENT_ID=
ZOOM_GIULIANO_CLIENT_SECRET=
ZOOM_GIULIANO_REDIRECT_URI=https://prospectos-sm-production.up.railway.app/zoom/oauth/callback
